/* --- Deep Night Theme (نسخه کامل و بهینه شده) --- */

/* 1. تنظیمات عمومی و ریست */
* {
    font-family: "Vazirmatn", "Segoe UI", "Tahoma", sans-serif;
    font-size: 14px;
    outline: none;
    selection-background-color: #7f5af0; /* بنفش نئونی */
    selection-color: #ffffff;
}

/* 2. پنجره اصلی و پس‌زمینه */
QMainWindow, QWidget#centralwidget, QDialog {
    background-color: #16161a; /* مشکی عمیق */
    color: #fffffe;
}

/* 3. سایدبار (Sidebar) */
QFrame#sidebar {
    background-color: #242629;
    border-radius: 16px;
    border: 1px solid #16161a; /* بوردر هم‌رنگ پس‌زمینه برای تمیزی */
}

QFrame#sidebar QLabel#app_title {
    color: #fffffe;
    font-weight: bold;
    font-size: 18px;
    padding-right: 5px;
}

/* دکمه‌های سایدبار */
QFrame#sidebar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    text-align: right;
    padding: 10px 15px;
    color: #94a1b2; /* خاکستری روشن */
    font-weight: 500;
    margin: 4px 8px;
}

QFrame#sidebar QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #fffffe;
}

QFrame#sidebar QPushButton:checked {
    /* گرادینت بنفش افقی */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7f5af0, stop:1 #6246ea);
    color: #fffffe;
    font-weight: bold;
    /* خط نشانگر سمت راست (مخصوص راست‌چین) */
    border-right: 4px solid #ffffff;
    padding-right: 12px;
}

/* دکمه منوی همبرگری */
QFrame#sidebar QPushButton#menu_btn {
    text-align: center;
    padding: 0;
    margin: 0;
}
QFrame#sidebar QPushButton#menu_btn:hover {
    background-color: rgba(127, 90, 240, 0.2);
    border-radius: 8px;
}

/* کادر وضعیت در سایدبار */
QFrame#status_container {
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* 4. ورودی‌ها (Inputs) */
QLineEdit, QComboBox, QTextEdit, QSpinBox, QDoubleSpinBox, QTimeEdit, QPlainTextEdit {
    background-color: #16161a;
    border: 1px solid #72757e;
    border-radius: 8px;
    padding: 8px 10px;
    color: #fffffe;
    font-size: 13px;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #7f5af0;
    background-color: #1a1a20;
}

/* حالت غیرفعال اینپوت */
QLineEdit:disabled, QComboBox:disabled {
    background-color: #202025;
    color: #555;
    border-color: #333;
}

/* دراپ‌دون کمبوباکس */
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: none;
    /* ساخت مثلث با CSS بجای عکس */
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94a1b2;
    margin-right: 10px;
}

/* 5. دکمه‌ها (Buttons) */
QPushButton {
    background-color: #2cb67d; /* سبز موفقیت (پیش‌فرض) */
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 6px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #29a370;
}

QPushButton:pressed {
    background-color: #248f61;
    padding-top: 10px; /* افکت کلیک */
}

/* دکمه‌های ثانویه (کنسل / ویرایش) */
QPushButton#secondary_btn {
    background-color: #3a3a4e;
    border: 1px solid #72757e;
    color: #fffffe;
}
QPushButton#secondary_btn:hover {
    background-color: #4a4a62;
    border-color: #94a1b2;
}

/* دکمه خطر (حذف) - این ID را باید در کد پایتون ست کنید */
QPushButton#delete_btn {
    background-color: #ef476f;
    color: white;
}
QPushButton#delete_btn:hover {
    background-color: #d64064;
}

/* دکمه غیرفعال */
QPushButton:disabled {
    background-color: #242629;
    color: #72757e;
    border: 1px solid #2b2c37;
}

/* 6. جدول‌ها (Tables) */
QTableWidget {
    background-color: #242629;
    border: 1px solid #72757e;
    border-radius: 10px;
    gridline-color: rgba(255, 255, 255, 0.05);
    selection-background-color: rgba(127, 90, 240, 0.25); /* هایلایت بنفش شفاف */
    selection-color: #fffffe;
}

QHeaderView::section {
    background-color: #16161a;
    color: #94a1b2;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #7f5af0;
    font-weight: bold;
}

QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* گوشه بالا سمت راست جدول */
QTableCornerButton::section {
    background-color: #16161a;
    border: none;
}

/* 7. اسکرول بار (ScrollBars) */
QScrollBar:vertical {
    background: #16161a;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #72757e;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #7f5af0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #16161a;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #72757e;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #7f5af0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* 8. چک‌باکس (CheckBox) */
QCheckBox {
    spacing: 8px;
    color: #e4e5f1;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background: #16161a;
    border: 1px solid #72757e;
    border-radius: 4px;
}
QCheckBox::indicator:hover {
    border-color: #7f5af0;
}
QCheckBox::indicator:checked {
    background-color: #2cb67d;
    border-color: #2cb67d;
    /* ایجاد یک مربع کوچک سفید وسط چک‌باکس بدون نیاز به عکس */
    image: url(none); 
    border-image: none;
}
/* ترفند CSS برای تیک: وقتی چک شد، یک بوردر داخلی اضافه کن تا شبیه تیک شود */
QCheckBox::indicator:checked {
    background-color: #2cb67d;
    border: 4px solid #16161a; /* این باعث می‌شود وسطش سبز بماند و دورش خالی شود */
}

/* 9. کارت‌ها (Cards) */
QFrame#card {
    background-color: #242629;
    border: 1px solid #16161a;
    border-radius: 12px;
}
QFrame#card:hover {
    border: 1px solid #7f5af0; /* درخشش بنفش هنگام موس‌آوِر */
}

/* 10. لیبل‌ها */
QLabel { color: #fffffe; }
QLabel#subtitle { color: #94a1b2; font-size: 12px; }
QLabel#h1 { font-size: 20px; font-weight: bold; color: #fffffe; }
QLabel#h2 { font-size: 16px; font-weight: bold; color: #e4e5f1; }

/* 11. تولتیپ (Tooltip) */
QToolTip {
    background-color: #242629;
    color: #fffffe;
    border: 1px solid #7f5af0;
    border-radius: 4px;
    padding: 5px;
}

/* 12. مسیج باکس و دیالوگ‌ها */
QMessageBox {
    background-color: #16161a;
}
QMessageBox QLabel {
    color: #fffffe;
}
/* دکمه‌های مسیج باکس از استایل عمومی دکمه ارث می‌برند */

/* 13. منوی راست کلیک (Context Menu) */
QMenu {
    background-color: #242629;
    border: 1px solid #72757e;
    color: #fffffe;
    padding: 5px;
}
QMenu::item {
    padding: 5px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #7f5af0;
    color: white;
}